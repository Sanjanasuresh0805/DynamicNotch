<Window x:Class="DynamicNotch.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="220"
        Height="40"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- ══ SPRING EXPAND STORYBOARD ══ -->
        <Storyboard x:Key="ExpandStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Width"
                From="220" To="680"
                Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.15"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Height"
                From="40" To="140"
                Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.08"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="CollapsedContent"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0"
                Duration="0:0:0.10">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="ExpandedContent"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                BeginTime="0:0:0.18"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ══ SPRING COLLAPSE STORYBOARD ══ -->
        <Storyboard x:Key="CollapseStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ExpandedContent"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0"
                Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Width"
                From="680" To="220"
                Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Height"
                From="140" To="40"
                Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="9"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="CollapsedContent"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                BeginTime="0:0:0.22"
                Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ══ EQUALIZER PULSE ANIMATION ══ -->
        <Storyboard x:Key="EqualizerStoryboard" RepeatBehavior="Forever">

            <!-- Bar 1 -->
            <DoubleAnimation
                Storyboard.TargetName="Bar1"
                Storyboard.TargetProperty="Height"
                From="4" To="14"
                Duration="0:0:0.5"
                AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Bar 2 — offset timing -->
            <DoubleAnimation
                Storyboard.TargetName="Bar2"
                Storyboard.TargetProperty="Height"
                From="14" To="4"
                Duration="0:0:0.6"
                AutoReverse="True"
                BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Bar 3 — different offset -->
            <DoubleAnimation
                Storyboard.TargetName="Bar3"
                Storyboard.TargetProperty="Height"
                From="6" To="12"
                Duration="0:0:0.45"
                AutoReverse="True"
                BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </Window.Resources>

    <!-- ══ ROOT BORDER ══ -->
    <Border x:Name="IslandBorder"
        Width="220" Height="40"
        Background="#FF000000"
        CornerRadius="18"
        ClipToBounds="True"
        HorizontalAlignment="Center"
        VerticalAlignment="Top">

        <Grid>

            <!-- ══ COLLAPSED CONTENT ══ -->
            <Grid x:Name="CollapsedContent" Opacity="1">

                <!-- Album art anchored LEFT -->
                <Border Width="30" Height="27"
                        CornerRadius="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0"
                        Visibility="{Binding HasMedia,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding MediaThumbnail}"
                                    Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!-- Time centered -->
                <TextBlock Text="{Binding CurrentTime}"
                           Foreground="White"
                           FontSize="12"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Animated equalizer bars anchored RIGHT (when playing) -->
                <StackPanel x:Name="EqualizerBars"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Visibility="{Binding IsPlaying,
                                Converter={StaticResource BoolToVisibilityConverter}}">

                    <Rectangle x:Name="Bar1"
                               Width="2.5" Height="6"
                               Fill="White"
                               RadiusX="1.5" RadiusY="1.5"
                               Margin="1,0"
                               VerticalAlignment="Center"/>

                    <Rectangle x:Name="Bar2"
                               Width="2.5" Height="10"
                               Fill="White"
                               RadiusX="1.5" RadiusY="1.5"
                               Margin="1,0"
                               VerticalAlignment="Center"/>

                    <Rectangle x:Name="Bar3"
                               Width="2.5" Height="7"
                               Fill="White"
                               RadiusX="1.5" RadiusY="1.5"
                               Margin="1,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ══ EXPANDED CONTENT ══ -->
            <Grid x:Name="ExpandedContent" Opacity="0" Margin="14,8,14,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ══════════════════════════════════════
                     COLUMN 0: MEDIA
                     ══════════════════════════════════════ -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Album Art -->
                    <Border Grid.Column="0"
                            Width="70" Height="72"
                            CornerRadius="8"
                            ClipToBounds="True"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding MediaThumbnail}"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <!-- Track info + controls -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Width="150">
                        <TextBlock Text="{Binding MediaTitle}"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding MediaArtist}"
                                   Foreground="#FF8E8E93"
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,8"/>

                        <!-- BIGGER MEDIA BUTTONS (28x28) -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource MediaButtonStyle}"
                                    Width="28" Height="28"
                                    Click="PreviousButton_Click">
                                <TextBlock Text="&#xE892;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"/>
                            </Button>
                            <Button Style="{StaticResource MediaButtonStyle}"
                                    Width="28" Height="28"
                                    Margin="6,0"
                                    Click="PlayPauseButton_Click">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE769;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Text" Value="&#xE768;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource MediaButtonStyle}"
                                    Width="28" Height="28"
                                    Click="NextButton_Click">
                                <TextBlock Text="&#xE893;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════════════════
     COLUMN 1: CALENDAR
     ══════════════════════════════════════ -->
<Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0,20,0">

    <StackPanel Orientation="Vertical" HorizontalAlignment="Left">

        <!-- Main row: Aug + day-cells -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left">

            <TextBlock Text="{Binding CurrentMonth}"
                       Foreground="White"
                       FontSize="23"
                       FontWeight="Bold"
                       FontFamily="Segoe UI"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

                            <ItemsControl ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="28" Margin="1,0"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DayOfWeekLetter}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       FontFamily="Segoe UI"
                                                       Margin="0,0,0,4">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF8E8E93"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFF453A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Grid HorizontalAlignment="Center"
                                                  Width="26" Height="26">
                                                <Ellipse Width="26" Height="26"
                                                         Fill="#FF007AFF"
                                                         Visibility="{Binding IsToday,
                                                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding Day, StringFormat={}{0:00}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontFamily="Segoe UI">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FFCCCCCC"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFFF453A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Today's event -->
                        <!-- Today's event -->
<StackPanel Orientation="Horizontal"
            HorizontalAlignment="center"
            Margin="0,8,0,0">
                            <TextBlock Text="&#xE787;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="#FF636366"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding TodayEvent}"
                                        Foreground="#FF8E8E93"
                                        FontSize="10"
                                        FontFamily="Segoe UI"
                                        VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ══════════════════════════════════════
                     COLUMN 2: RIGHT SIDE
                     ══════════════════════════════════════ -->
                <Grid Grid.Column="2" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Weather | Battery | Settings — EQUAL SPACING -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,0,0,4">

                        <!-- Weather -->
                        <TextBlock Text="{Binding WeatherTemp}"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <!-- Battery (hidden if no battery detected) -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    Visibility="{Binding IsBatteryAvailable,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding BatteryIcon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{Binding BatteryColor}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding BatteryText}"
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Settings gear -->
                        <Button Style="{StaticResource SettingsButtonStyle}"
                                Width="20" Height="20"
                                Click="SettingsButton_Click"
                                ToolTip="Settings">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="11"/>
                        </Button>
                    </StackPanel>

                    <!-- Mirror (perfect circle via Ellipse-based clipping) -->
                    <Button Grid.Row="1"
                            x:Name="MirrorBtn"
                            Style="{StaticResource MirrorButtonStyle}"
                            Width="66" Height="66"
                            Click="MirrorButton_Click"
                            ToolTip="Toggle Mirror"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,4,24,0">
                        <Grid Width="66" Height="66">
                            <Ellipse x:Name="WebcamEllipse"
                                     Width="66" Height="66"
                                     Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="WebcamBrush"
                                                Stretch="UniformToFill"
                                                AlignmentX="Center"
                                                AlignmentY="Center">
                                        <ImageBrush.RelativeTransform>
                                            <ScaleTransform ScaleX="-1"
                                                            CenterX="0.5"
                                                            CenterY="0.5"/>
                                        </ImageBrush.RelativeTransform>
                                    </ImageBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <Viewbox x:Name="WebcamIcon"
                                     Width="32" Height="32"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="100" Height="100">
                                    <Path Data="M 10,20 Q 10,10 20,10 L 80,10 Q 90,10 90,20 L 90,65 Q 90,75 80,75 L 20,75 Q 10,75 10,65 Z"
                                          Fill="#FF3A3A3C"/>
                                    <Ellipse Canvas.Left="30" Canvas.Top="20"
                                             Width="40" Height="40"
                                             Fill="#FF2C2C2E"
                                             Stroke="#FF636366"
                                             StrokeThickness="3"/>
                                    <Ellipse Canvas.Left="38" Canvas.Top="28"
                                             Width="24" Height="24"
                                             Fill="#FF1C1C1E"/>
                                    <Ellipse Canvas.Left="44" Canvas.Top="34"
                                             Width="12" Height="12"
                                             Fill="#FF007AFF"/>
                                    <Rectangle Canvas.Left="42" Canvas.Top="75"
                                               Width="16" Height="10"
                                               Fill="#FF3A3A3C"/>
                                    <Rectangle Canvas.Left="30" Canvas.Top="85"
                                               Width="40" Height="8"
                                               RadiusX="4" RadiusY="4"
                                               Fill="#FF3A3A3C"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>