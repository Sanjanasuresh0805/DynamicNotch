<Window x:Class="DynamicNotch.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="180"
        Height="30"
        WindowStartupLocation="Manual">

    <Window.Resources>

        <!-- ══ SPRING EXPAND STORYBOARD ══ -->
        <Storyboard x:Key="ExpandStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Width"
                From="180" To="620"
                Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.15"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Height"
                From="30" To="130"
                Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.08"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="CollapsedContent"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0"
                Duration="0:0:0.10">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="ExpandedContent"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                BeginTime="0:0:0.18"
                Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ══ SPRING COLLAPSE STORYBOARD ══ -->
        <Storyboard x:Key="CollapseStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ExpandedContent"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0"
                Duration="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Width"
                From="620" To="180"
                Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="8"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="IslandBorder"
                Storyboard.TargetProperty="Height"
                From="130" To="30"
                Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="9"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation
                Storyboard.TargetName="CollapsedContent"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1"
                BeginTime="0:0:0.22"
                Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </Window.Resources>

    <!-- ══ ROOT BORDER (the notch shape) ══ -->
    <Border x:Name="IslandBorder"
            Width="180" Height="30"
            Background="#FF000000"
            CornerRadius="0,0,15,15"
            ClipToBounds="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">

        <!-- ══ WRAPPER GRID (holds both collapsed + expanded content) ══ -->
        <Grid>

            <!-- ══ COLLAPSED CONTENT ══ -->
            <Grid x:Name="CollapsedContent" Opacity="1">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="6,0">

                    <Border Width="18" Height="18"
                            CornerRadius="3"
                            Margin="0,0,5,0"
                            Visibility="{Binding HasMedia,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding MediaThumbnail}"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <TextBlock Text="{Binding CurrentTime}"
                               Foreground="White"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding WeatherTemp}"
                               Foreground="#FFAAAAAA"
                               FontSize="10"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>

                    <Ellipse Width="5" Height="5"
                             Fill="#FF30D158"
                             Margin="5,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsPlaying,
                                 Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>

            <!-- ══ EXPANDED CONTENT ══ -->
            <Grid x:Name="ExpandedContent" Opacity="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <!-- COLUMN 0: MEDIA -->
                <Grid Grid.Column="0" Margin="10,8,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="72" Height="72"
                          VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border CornerRadius="8" ClipToBounds="True"
                                Width="72" Height="72">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding MediaThumbnail}"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border Width="18" Height="18"
                                Background="#CC000000"
                                CornerRadius="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,1,1">
                            <TextBlock Text="{Binding SourceApp}"
                                       Foreground="White"
                                       FontSize="6"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MediaTitle}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="108"/>
                        <TextBlock Text="{Binding MediaAlbum}"
                                   Foreground="#FF8E8E93"
                                   FontSize="9"
                                   FontFamily="Segoe UI"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="108"
                                   Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding MediaArtist}"
                                   Foreground="#FF8E8E93"
                                   FontSize="9"
                                   FontFamily="Segoe UI"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="108"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource MediaButtonStyle}"
                                    Width="22" Height="22"
                                    Click="PreviousButton_Click"
                                    ToolTip="Previous">
                                <TextBlock Text="&#xE892;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"/>
                            </Button>
                            <Button Style="{StaticResource MediaButtonStyle}"
                                    Width="22" Height="22"
                                    Margin="4,0"
                                    Click="PlayPauseButton_Click"
                                    ToolTip="Play / Pause">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE769;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}"
                                                             Value="True">
                                                    <Setter Property="Text" Value="&#xE768;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource MediaButtonStyle}"
                                    Width="22" Height="22"
                                    Click="NextButton_Click"
                                    ToolTip="Next">
                                <TextBlock Text="&#xE893;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- COLUMN 1: CALENDAR + WEATHER -->
                <Grid Grid.Column="1" Margin="4,8,4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding CurrentMonth}"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding WeatherIcon}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,3,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding WeatherTemp}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding WeatherCondition}"
                                           Foreground="#FF8E8E93"
                                           FontSize="8"
                                           FontFamily="Segoe UI"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="70"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Rectangle Grid.Row="1"
                               Height="1"
                               Fill="#22FFFFFF"
                               Margin="0,0,0,4"/>

                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding CalendarDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="26"
                                            HorizontalAlignment="Center"
                                            Margin="1,0">
                                    <TextBlock Text="{Binding DayOfWeekShort}"
                                               HorizontalAlignment="Center"
                                               FontSize="8"
                                               FontFamily="Segoe UI">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FF8E8E93"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFF453A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Width="20" Height="20"
                                            CornerRadius="10"
                                            HorizontalAlignment="Center"
                                            Margin="0,2,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Background" Value="#FF007AFF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Day}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   FontFamily="Segoe UI">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF8E8E93"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFF453A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Row="3"
                               Text="{Binding WeatherCity}"
                               Foreground="#44FFFFFF"
                               FontSize="8"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- COLUMN 2: MIRROR + SETTINGS -->
                <Grid Grid.Column="2" Margin="4,8,8,8">

                    <Button x:Name="SettingsBtn"
                            Style="{StaticResource SettingsButtonStyle}"
                            Width="22" Height="22"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="SettingsButton_Click"
                            ToolTip="Settings">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"/>
                    </Button>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,8,0,0">

                        <Button x:Name="MirrorBtn"
                                Style="{StaticResource MirrorButtonStyle}"
                                Width="58" Height="58"
                                Click="MirrorButton_Click"
                                ToolTip="Toggle Mirror">
                            <Grid Width="58" Height="58">

                                <Ellipse x:Name="WebcamEllipse"
                                         Width="58" Height="58"
                                         Visibility="Collapsed">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="WebcamBrush"
                                                    Stretch="UniformToFill"
                                                    AlignmentX="Center"
                                                    AlignmentY="Center">
                                            <ImageBrush.RelativeTransform>
                                                <ScaleTransform ScaleX="-1"
                                                                CenterX="0.5"
                                                                CenterY="0.5"/>
                                            </ImageBrush.RelativeTransform>
                                        </ImageBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <Viewbox x:Name="WebcamIcon"
                                         Width="30" Height="30"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Canvas Width="100" Height="100">
                                        <Path Data="M 10,20 Q 10,10 20,10 L 80,10 Q 90,10 90,20 L 90,65 Q 90,75 80,75 L 20,75 Q 10,75 10,65 Z"
                                              Fill="#FF3A3A3C"/>
                                        <Ellipse Canvas.Left="30" Canvas.Top="20"
                                                 Width="40" Height="40"
                                                 Fill="#FF2C2C2E"
                                                 Stroke="#FF636366"
                                                 StrokeThickness="3"/>
                                        <Ellipse Canvas.Left="38" Canvas.Top="28"
                                                 Width="24" Height="24"
                                                 Fill="#FF1C1C1E"/>
                                        <Ellipse Canvas.Left="44" Canvas.Top="34"
                                                 Width="12" Height="12"
                                                 Fill="#FF007AFF"/>
                                        <Rectangle Canvas.Left="42" Canvas.Top="75"
                                                   Width="16" Height="10"
                                                   Fill="#FF3A3A3C"/>
                                        <Rectangle Canvas.Left="30" Canvas.Top="85"
                                                   Width="40" Height="8"
                                                   RadiusX="4" RadiusY="4"
                                                   Fill="#FF3A3A3C"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>

                        <TextBlock Text="Mirror"
                                   Foreground="#FF8E8E93"
                                   FontSize="9"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>