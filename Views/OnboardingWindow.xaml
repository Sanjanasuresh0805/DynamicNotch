<Window x:Class="DynamicNotch.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to DynamicNotch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="500" Height="380"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border CornerRadius="24" Padding="40">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1A1A2E" Offset="0" />
                <GradientStop Color="#FF16213E" Offset="0.5" />
                <GradientStop Color="#FF0F3460" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="5" Opacity="0.6" />
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">
            <Border Width="80" Height="40" CornerRadius="20"
                    Background="#FF0D0D0D"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#FF30D158" Margin="0,0,4,0" />
                    <TextBlock Text="19:53"
                               Foreground="White"
                               FontSize="13" FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Text="DynamicNotch"
                       Foreground="White"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI" />

            <TextBlock Text="Your laptop's Dynamic Island"
                       Foreground="#99FFFFFF"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"
                       FontFamily="Segoe UI" />

            <TextBlock TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#77FFFFFF"
                       FontSize="12"
                       Margin="0,20,0,0"
                       LineHeight="20"
                       FontFamily="Segoe UI">
                Hover over the notch at the top of your screen to expand it.
                Control your media, check the calendar, or use the mirror.
                It works with Spotify, YouTube, Netflix, and more.
            </TextBlock>

            <StackPanel Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                    <TextBlock Text="🎵" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Auto-detects playing media" Foreground="#AAFFFFFF" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                    <TextBlock Text="📅" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Real-time calendar at a glance" Foreground="#AAFFFFFF" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                    <TextBlock Text="🪞" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Quick mirror with your webcam" Foreground="#AAFFFFFF" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <Button Margin="0,28,0,0"
                    Width="160" Height="40"
                    Click="GetStarted_Click"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                CornerRadius="20"
                                Background="#FF007AFF"
                                Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FF0A84FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FF0066CC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="Get Started"
                           Foreground="White"
                           FontSize="14" FontWeight="SemiBold"
                           FontFamily="Segoe UI" />
            </Button>
        </StackPanel>
    </Border>
</Window>