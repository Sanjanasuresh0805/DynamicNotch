<Application x:Class="DynamicNotch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/IslandWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ══ COLORS ══ -->
        <Color x:Key="IslandBackgroundColor">#FF000000</Color>
        <Color x:Key="AccentBlueColor">#FF007AFF</Color>
        <Color x:Key="AccentGreenColor">#FF30D158</Color>
        <Color x:Key="AccentRedColor">#FFFF453A</Color>
        <Color x:Key="SurfaceDarkColor">#FF1C1C1E</Color>
        <Color x:Key="SurfaceMediumColor">#FF2C2C2E</Color>
        <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
        <Color x:Key="TextSecondaryColor">#FF8E8E93</Color>
        <Color x:Key="TextTertiaryColor">#FF636366</Color>

        <!-- ══ BRUSHES ══ -->
        <SolidColorBrush x:Key="IslandBackground"   Color="{StaticResource IslandBackgroundColor}"/>
        <SolidColorBrush x:Key="AccentBlue"         Color="{StaticResource AccentBlueColor}"/>
        <SolidColorBrush x:Key="AccentGreen"        Color="{StaticResource AccentGreenColor}"/>
        <SolidColorBrush x:Key="AccentRed"          Color="{StaticResource AccentRedColor}"/>
        <SolidColorBrush x:Key="SurfaceDark"        Color="{StaticResource SurfaceDarkColor}"/>
        <SolidColorBrush x:Key="SurfaceMedium"      Color="{StaticResource SurfaceMediumColor}"/>
        <SolidColorBrush x:Key="TextPrimary"        Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondary"      Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="TextTertiary"       Color="{StaticResource TextTertiaryColor}"/>

        <!-- ══ CONVERTERS ══ -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ══ MEDIA BUTTON STYLE ══ -->
        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderBrush"  Value="Transparent"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Padding"      Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ MIRROR BUTTON STYLE ══ -->
        <Style x:Key="MirrorButtonStyle" TargetType="Button">
            <Setter Property="Background"  Value="#FF2C2C2E"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="29"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                ClipToBounds="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#FF3A3A3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#FF48484A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ SETTINGS BUTTON STYLE ══ -->
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground"  Value="#FF8E8E93"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>